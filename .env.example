OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# Model used for story planning, dialogue, storyboard, and validation.
OPENAI_CHAT_MODEL=your-lm-studio-model-id
